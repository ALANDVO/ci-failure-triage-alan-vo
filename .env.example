# Production SSO. For local demo, follow README commands instead of Compose.
APP_ENV=production
AUTH_MODE=oidc
BIND_HOST=0.0.0.0
COOKIE_SECURE=true
FRONTEND_URL=https://triage.example.com
OIDC_DISCOVERY_URL=https://identity.example.com/realms/your-workspace/.well-known/openid-configuration
OIDC_CLIENT_ID=ci-failure-triage
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://triage.example.com/api/auth/callback
OIDC_ROLE_CLAIM=realm_access.roles
SESSION_TTL_SECONDS=28800
DATABASE_PATH=/data/triage.db
MAX_UPLOAD_BYTES=5242880
# Optional; no model request happens without explicit user consent.
LLM_API_KEY=
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
